# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Second Brain API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FORMAT: "json" for production log aggregators, "console" for local dev
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=second_brain

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Recommended chat models (pick one):
#   qwen2.5        — best balance of quality/speed for RAG (default)
#   llama3.2       — Meta's model, good general purpose
#   mistral        — fast, strong reasoning
#   llama3.2:1b    — fastest, use on weak hardware
OLLAMA_CHAT_MODEL=qwen2.5

# Timeouts (seconds)
OLLAMA_CONNECT_TIMEOUT=5.0
OLLAMA_CHAT_TIMEOUT=120.0
OLLAMA_EMBED_TIMEOUT=30.0

# Retry config
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=0.5

# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_PATH=./vault

# ── Incremental indexing ───────────────────────────────────────────────────────
# Where the sync engine stores its {note_path: hash} state file.
INDEX_STATE_PATH=./data/index_state.json
# Auto-sync interval in minutes. 0 = disabled (trigger manually via POST /ingest/sync).
# Example: 30 = sync every 30 minutes while the server is running.
SYNC_INTERVAL_MINUTES=0

# ── Hybrid search ─────────────────────────────────────────────────────────────
# Default mode: "hybrid" (vector + BM25), "semantic" (vector only), "keyword" (BM25 only)
HYBRID_DEFAULT_MODE=hybrid
# RRF weights. Higher weight = more influence on the fused ranking.
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
# RRF k-parameter (60 is the Cormack et al. standard)
HYBRID_RRF_K=60

# ── Ingestion ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
