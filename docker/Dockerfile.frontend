# Pin to a specific Alpine release so the tag is immutable and scanners can
# track CVEs against a known base. `apk upgrade` applies any in-repo security
# patches that landed after the image was published — keeps the layer green
# without waiting for an upstream tag update.

# ─── dev ──────────────────────────────────────────────────────────────────────
# The entire frontend directory is bind-mounted at runtime, so the COPY/npm ci
# here only runs when the image is first built or package.json changes.
# Nuxt/Vite picks up file changes via CHOKIDAR_USEPOLLING=true.
FROM node:22-alpine3.21 AS dev

RUN apk upgrade --no-cache

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

EXPOSE 3000 24678
CMD ["npm", "run", "dev"]

# ─── builder ──────────────────────────────────────────────────────────────────
# Standalone build stage — produces the .output directory used by the prod runner.
FROM node:22-alpine3.21 AS builder

RUN apk upgrade --no-cache

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ─── prod ─────────────────────────────────────────────────────────────────────
# Minimal runtime image: only the compiled .output from the builder stage.
# No source code, no node_modules, no dev tools.
FROM node:22-alpine3.21 AS prod

RUN apk upgrade --no-cache

WORKDIR /app
COPY --from=builder /app/.output ./.output

ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
