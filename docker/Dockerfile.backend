# ─── base ─────────────────────────────────────────────────────────────────────
# Shared layer: system packages + Python deps. Cached until requirements change.
FROM python:3.12-slim AS base

WORKDIR /app

# tini: minimal init process for containers.
# PID 1 in Docker doesn't automatically reap zombie processes or forward signals.
# tini wraps our process so SIGTERM from `docker stop` reaches uvicorn cleanly,
# enabling graceful shutdown within the configured timeout.
RUN apt-get update && apt-get install -y --no-install-recommends tini wget \
    && rm -rf /var/lib/apt/lists/*

# uv: fast pip replacement — 10-100x faster installs, deterministic output
RUN pip install --no-cache-dir uv==0.5.14

COPY requirements/base.txt requirements/base.txt
RUN uv pip install --system --no-cache -r requirements/base.txt

# Non-root user — defence-in-depth: even if an RCE exists, the attacker
# lands as an unprivileged user with no write access outside /app
RUN useradd -m -u 1001 appuser

# data/ holds the index state file — must be writable at runtime
RUN mkdir -p /app/data && chown appuser:appuser /app/data

COPY --chown=appuser:appuser . .

# Liveness probe baked into the image so it works even without a compose file.
# /health never checks external services — fast, always returns 200 while alive.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:8000/health || exit 1

# ─── dev ──────────────────────────────────────────────────────────────────────
# Source code is bind-mounted at runtime (see docker-compose.yml), so changes
# to app/ are picked up by uvicorn without rebuilding the image.
FROM base AS dev
USER appuser
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ─── prod ─────────────────────────────────────────────────────────────────────
# No bind mount. Code is baked into the image at build time.
# WEB_CONCURRENCY defaults to 2 (safe for single-core I/O-bound app).
# Override with WEB_CONCURRENCY=4 env var for multi-core hosts.
FROM base AS prod
USER appuser
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2", \
     "--timeout-graceful-shutdown", "30"]
